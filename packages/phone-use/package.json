{
  "name": "phone-use",
  "version": "0.8.2",
  "description": "Natural-language phone control for AI agents — CLI, MCP server, and agent SDK",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "homepage": "https://www.phoneuse.dev",
  "bugs": {
    "url": "https://github.com/Derivate-Inc/phone-use/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Derivate-Inc/phone-use.git",
    "directory": "packages/phone-use"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "mcp-server",
    "ios",
    "simulator",
    "phone",
    "mobile",
    "automation",
    "computer-use",
    "claude"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "bin": {
    "phone-use": "bin/phone-use.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk.d.mts",
      "bun": "./src/sdk.ts",
      "import": "./dist/sdk.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "mcp": "bun src/index.ts mcp",
    "task": "bun src/index.ts task",
    "bench": "bun src/index.ts bench",
    "bench:agent": "bun scripts/bench-agent.ts",
    "smoke": "bun scripts/smoke-sdk.ts && bun scripts/smoke-recorder-mcp.ts && bun scripts/smoke-atlas.ts && bun scripts/smoke-skill.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phone-use/sdk": "0.7.1",
    "openai": "6.26.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
