{
  "name": "@phone-use/cloud",
  "version": "0.0.5",
  "description": "Self-hosted mobile sandbox control plane, workers, and remote SDK backend",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "bin": {
    "phone-use-cloud": "src/control-plane-main.ts",
    "phone-use-worker": "src/worker-main.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./control-plane": {
      "bun": "./src/control-plane.ts",
      "import": "./src/control-plane.ts"
    },
    "./worker": {
      "bun": "./src/worker.ts",
      "import": "./src/worker.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "scripts": {
    "build": "tsdown src/index.ts",
    "typecheck": "tsc --noEmit",
    "start:control": "bun src/control-plane-main.ts",
    "start:worker": "bun src/worker-main.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@phone-use/sdk": "workspace:*",
    "better-auth": "^1.6.25",
    "hono": "^4.12.34"
  },
  "private": true
}