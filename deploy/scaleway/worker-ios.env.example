PHONE_USE_CLOUD_URL=https://control.example.com
PHONE_USE_CLOUD_WORKER_TOKEN=replace-with-the-worker-token
PHONE_USE_WORKER_PLATFORM=ios
PHONE_USE_WORKER_ID=scw-ios-par1-01
PHONE_USE_WORKER_PUBLIC_URL=https://ios-worker.example.com
# Measured on M2-L 16 GB (docs/30): 11 slimmed sims clean, 12 degrades the host.
# 8 + a 2-deep warm pool = 6 attachable at once with two pre-booted for bursts.
# Halve both on an 8 GB M1-M. Usable concurrency is CAPACITY minus WARM_POOL.
PHONE_USE_WORKER_CAPACITY=8
PHONE_USE_WORKER_WARM_POOL=2
# Warm phones get their automation runner started before handout. Optional:
# hold back the pool rebuild after a handout so it can't compete with live phones,
# and preinstall one .app on every warm phone.
# PHONE_USE_WARM_REFILL_DELAY_MS=240000
# PHONE_USE_WARM_APP=/opt/phone-use/App.app
PHONE_USE_WORKER_DATA=/var/lib/phone-use/worker
PHONE_USE_IOS_GOLDEN_UDID=replace-with-shutdown-golden-simulator-udid
HOST=127.0.0.1
PORT=8090
# Build first: sh apps/api/native/build.sh (uses the selected Xcode).
# Optional override for the native H.264 capture helper:
# PHONE_USE_VIDEO_BIN=/opt/phone-use/phone-video
