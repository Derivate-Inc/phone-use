<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TLS front for the worker (device RPC, /stream and video at
  https://ios-worker.example.com/worker/*). Without it the worker still
  heartbeats to the control plane, so phones get created, but nothing can
  reach them. As a LaunchDaemon it starts at boot, like the worker.
  The paths below assume the host's user is `m1`, the default account on a
  Scaleway Mac; change them for another user.
  Install: sudo cp to /Library/LaunchDaemons, chown root:wheel, chmod 644,
  sudo launchctl bootstrap system /Library/LaunchDaemons/com.phone-use.caddy.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.phone-use.caddy</string>
  <key>UserName</key><string>m1</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/m1/bin/caddy</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/m1/Caddyfile</string>
    <string>--adapter</string>
    <string>caddyfile</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/m1</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/m1/Library/Logs/caddy.log</string>
  <key>StandardErrorPath</key><string>/Users/m1/Library/Logs/caddy.log</string>
</dict>
</plist>
