PHONE_USE_CLOUD_URL=https://control.example.com
PHONE_USE_CLOUD_WORKER_TOKEN=replace-with-the-worker-token
PHONE_USE_WORKER_PLATFORM=android
PHONE_USE_WORKER_ID=scw-android-par1-01
PHONE_USE_WORKER_PUBLIC_URL=https://android-worker.example.com
PHONE_USE_WORKER_CAPACITY=2
PHONE_USE_WORKER_WARM_POOL=1
PHONE_USE_WORKER_DATA=/var/lib/phone-use/worker
# Provider: `emulator` (headless -read-only instances of one AVD; the default)
# or `cuttlefish` (cvd; see docs/30 §3b).
PHONE_USE_ANDROID_PROVIDER=emulator
ANDROID_HOME=/opt/android-sdk
PHONE_USE_ADB_BIN=/opt/android-sdk/platform-tools/adb
PHONE_USE_ANDROID_AVD=phone-use-golden
PHONE_USE_ANDROID_BASE_PORT=5554
PHONE_USE_ANDROID_EMULATOR_ARGS=-gpu swiftshader_indirect
PHONE_USE_ANDROID_BOOT_TIMEOUT_MS=180000
# Cuttlefish only:
# PHONE_USE_ANDROID_ROOT=/var/lib/phone-use/cuttlefish
# PHONE_USE_ANDROID_ARTIFACTS=/opt/cuttlefish/images
# PHONE_USE_ANDROID_BASE_INSTANCE=1
# PHONE_USE_ANDROID_GPU_MODE=guest_swiftshader
# PHONE_USE_ANDROID_SERIAL_TEMPLATE=127.0.0.1:{port}
HOST=127.0.0.1
PORT=8090
