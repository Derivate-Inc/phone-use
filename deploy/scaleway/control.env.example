PHONE_USE_CLOUD_API_TOKEN=replace-with-openssl-rand-base64-32
PHONE_USE_CLOUD_WORKER_TOKEN=replace-with-a-different-openssl-rand-base64-32
PHONE_USE_CLOUD_DB=/var/lib/phone-use/control/phone-use-cloud.sqlite
HOST=127.0.0.1
PORT=8080
# Launch posture without demo mode: hour-long phones, but abandoned ones free
# their slot after 5 min, and one phone per account. (Demo mode overrides all.)
# PHONE_USE_DEFAULT_IDLE_MS=300000
# PHONE_USE_MAX_ACTIVE_PER_TENANT=1
