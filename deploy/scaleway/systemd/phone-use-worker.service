[Unit]
Description=phone-use Android sandbox worker (emulator or Cuttlefish)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phoneuse
Group=phoneuse
SupplementaryGroups=kvm
WorkingDirectory=/opt/phone-use
EnvironmentFile=/etc/phone-use/worker.env
ExecStart=/home/phoneuse/.bun/bin/bun apps/api/src/worker-main.ts
Restart=always
RestartSec=2
LimitNOFILE=1048576
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
